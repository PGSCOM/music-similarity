# cp .env.example .env and fill it in (.env is not committed)
# Write token of the account that owns the public bucket with the MP3s (created if missing)
HF_TOKEN=hf_...
BUCKET=other-account/spotify-previews
# Read token of the account with the private parquet
HF_SOURCE_TOKEN=hf_...
SOURCE=hf://buckets/PGSCOM/music-similarity/privado/tracks_top15000.parquet
